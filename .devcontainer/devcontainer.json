// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "tablegpt-agent",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12",

	"containerEnv": {
		"UV_COMPILE_BYTECODE": "1",
		"UV_CACHE_DIR": "/home/${containerUser}/.cache/uv"
	},
	"features": {
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
		"ghcr.io/jsburckhardt/devcontainer-features/ruff:1": {},
		"ghcr.io/jsburckhardt/devcontainer-features/codex:1": {}
    },

	// Use 'postCreateCommand' to run commands after the container is created.
	// Install uv and sync all default dependency groups.
	"postCreateCommand": "uv sync",

	// See https://stackoverflow.com/questions/70206554/share-ssh-keys-with-vs-code-devcontainer-running-with-dockers-wsl2-backend
	"mounts": [
    	"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/${containerUser}/.ssh,readonly"
	]
}
